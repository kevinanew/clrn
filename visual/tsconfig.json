{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": [
    "run-visual.ts",
    "run-visual-config.ts",
    "run-visual-config.test.ts",
    "open-report.ts",
    "playwright.config.ts",
    "scenarios.ts",
    "scenarios.test.ts",
    "src/**/*.ts",
    "tests/**/*.ts"
  ]
}
